# Optional error monitoring (https://sentry.io). Set in Netlify > Environment variables; leave empty to disable.
VITE_SENTRY_DSN=

# Optional cookieless analytics (https://umami.is, Umami Cloud). Paste the Website ID from Umami > Settings > Websites;
# leave empty to disable. Page views, referrers and UTM tags (?utm_source=tiktok) are recorded without cookies.
VITE_UMAMI_WEBSITE_ID=
