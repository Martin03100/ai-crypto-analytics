# Runtime
APP_ENV=development

# Security
JWT_SECRET_KEY=replace-with-a-random-secret
API_KEY_ENCRYPTION_SECRET=replace-with-another-random-secret
PASSWORD_HASH_ROUNDS=310000
TRUSTED_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=

# Email
BREVO_API_KEY=
EMAIL_FROM=no-reply@ai-crypto-analytics.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Captcha
TURNSTILE_SECRET_KEY=

# Data sources
COINGECKO_API_KEY=
FRED_API_KEY=
GITHUB_TOKEN=
BLOCKCHAIR_API_KEY=

# AI models
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# DEEPSEEK_MODEL=deepseek-v4-flash
# GROK_MODEL=grok-4.3

# Timeout (seconds) for a single AI provider call; keep the default when the frontend proxies /api via Netlify
# AI_REQUEST_TIMEOUT_SECONDS=12

# Optional error monitoring (https://sentry.io). Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
