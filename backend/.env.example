# Skopiruj tento subor ako .env a nastav vlastne hodnoty pred nasadenim do produkcie.
JWT_SECRET_KEY=zmen-ma-na-nahodny-64-znakovy-retazec
API_KEY_ENCRYPTION_SECRET=zmen-ma-na-iny-nahodny-retazec-pre-fernet
CORS_ORIGINS=http://localhost:5173
# "production" zapne Secure flag na auth cookie (vyzaduje HTTPS). Pre lokalny
# vyvoj cez http://localhost necháj "development".
APP_ENV=development

# Adresa frontendu — pouziva sa na zostavenie odkazu v emaile na reset hesla
# (napr. https://app.moja-domena.sk).
FRONTEND_URL=http://localhost:5173

# SMTP pre odosielanie emailov (reset hesla). Ak nevyplnis, appka funguje
# aj bez toho — v development rezime sa reset link vrati priamo v API
# odpovedi (a zaloguje na server), takze sa da otestovat aj bez SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ai-crypto-analytics.local
