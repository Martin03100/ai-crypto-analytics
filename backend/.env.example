# Runtime
APP_ENV=development

# Security
JWT_SECRET_KEY=replace-with-a-random-secret
API_KEY_ENCRYPTION_SECRET=replace-with-another-random-secret
PASSWORD_HASH_ROUNDS=310000
# How many proxies in front of the app append to X-Forwarded-For. The client IP is taken that many entries
# from the right, so a client cannot spoof it. Browser -> Netlify /api proxy -> Render: 2 (Render alone: 1).
# Check: the IP in Settings -> activity log must be your own, not a Netlify/Render address.
TRUSTED_PROXY_HOPS=0
# Background runner for users' scheduled forecasts (1 = on).
SCHEDULER_ENABLED=1
# On Render the backend pings RENDER_EXTERNAL_URL/api/health every 10 min so the free instance does not sleep (0 = off).
KEEP_AWAKE=1
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=

# Email
BREVO_API_KEY=
EMAIL_FROM=no-reply@ai-crypto-analytics.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Captcha
TURNSTILE_SECRET_KEY=

# Data sources
COINGECKO_API_KEY=
FRED_API_KEY=
GITHUB_TOKEN=
BLOCKCHAIR_API_KEY=

# AI models
# GEMINI_MODEL=gemini-3.8-flash
# Tried when the main Gemini model is overloaded or out of quota (comma separated, empty = none).
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# DEEPSEEK_MODEL=deepseek-v4-flash
# GROK_MODEL=grok-4.3

# Timeout (seconds) for a single AI provider call; keep the default when the frontend proxies /api via Netlify
# AI_REQUEST_TIMEOUT_SECONDS=12

# Optional error monitoring (https://sentry.io). Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Public address of the frontend, used in emails (weekly recap, unsubscribe) and Stripe redirects.
# APP_PUBLIC_URL=https://aicryptopredictor.netlify.app

# Premium payments (https://stripe.com). Billing stays off until all three are set; the app shows the waitlist instead.
# Webhook endpoint in Stripe: https://<backend>/api/billing/webhook with the events checkout.session.completed,
# invoice.paid, customer.subscription.created and customer.subscription.updated.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional yearly plan (a second recurring Stripe price). Without it only the monthly plan is offered.
STRIPE_PRICE_ID_YEARLY=
STRIPE_WEBHOOK_SECRET=
# PREMIUM_PRICE_LABEL=€4.99 / month

# Admin panel (/admin): comma-separated usernames. An admin must turn on 2FA before the panel opens.
ADMIN_USERNAMES=

# Telegram alerts for Premium users: create a bot with @BotFather, paste its token and username (without @).
# The server polls Telegram itself, no webhook needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
